// Cloudflare Worker 설정. `cloudflare/` 폴더에서 `npx wrangler@4 deploy`로 배포한다.
{
  "name": "short-url",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",

  // 화면 파일. scripts/build-cloudflare.sh가 만든다(git에는 올리지 않는다).
  // 여기 있는 파일과 주소가 맞으면 Worker 코드를 거치지 않고 Cloudflare가 바로 준다.
  "assets": {
    "directory": "./public",
    "not_found_handling": "none"
  },

  "vars": {
    // 생성 API와 /번호 이동을 처리하는 Railway 백엔드 주소. 비밀 값이 아니다.
    "BACKEND_ORIGIN": "https://short-url-production-da76.up.railway.app"
  }
}
