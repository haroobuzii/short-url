# 이 파일을 .env로 복사해서 쓴다. .env는 git에 올라가지 않는다.
# 실제 배포 값(Railway DB 비밀번호 등)은 여기 적지 말고 Railway 환경 변수에만 넣는다.

# PostgreSQL 접속 주소. 아래 값은 docker-compose.yml의 로컬 개발용 DB를 가리킨다.
DATABASE_URL=postgres://shorturl:shorturl@localhost:5432/shorturl

# 이 서비스의 공개 주소. 이 주소를 가리키는 URL은 단축을 거절한다. 비워 두면 그 검사를 건너뛴다.
# 주소가 여러 개면 쉼표로 이어 적는다. 예: https://a.workers.dev,https://b.up.railway.app
PUBLIC_ORIGIN=http://localhost:8080
